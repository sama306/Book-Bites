---
import type { CollectionEntry } from 'astro:content'

interface Props {
    book: CollectionEntry<'books'>
}

const {book} = Astro.props
---

<div class="book-card">
    <img 
        src={book.data.cover ? (book.data.cover.startsWith('/') ? book.data.cover : `/${book.data.cover}`) : '/placeholder-book.webp'} 
        alt={book.data.title} 
        class="book-cover" 
    />
    <div class="card-content">
        <h3 class="book-title">{book.data.title}</h3>
        <p class="author-name">Por {book.data.author}</p>
        <p class="rating">Calificación: {book.data.rating}/10</p>
        <p class="book-summary">{book.data.summary}</p>
        <a href={`/books/${book.id}`} class="full-review">Leer Reseña</a>
    </div>
</div>

<style>
	.book-card {
		background-color: #f9f6fc;
		padding: 16px 20px;
		margin: 0;
		height: 100%;
		display: flex;
		gap: 20px;
		align-items: flex-start;
		box-shadow: 8px 8px 0 #ebe5f2;
        border: 1px solid #e0d5f0;
        border-radius: 8px;
	}
	.book-cover {
		width: 80px;
		height: 120px;
		object-fit: cover;
		border-radius: 2px;
		flex-shrink: 0;
	}
	.card-content { flex: 1; }
	.book-title	{
		font-size: 1.5rem;
		font-weight: bold;
		margin: 0;
	}
    .rating {
        font-weight: 500;
        color: #7a49c5;
        margin: 5px 0 10px 0;
    }
	.book-summary {
		font-size: 0.95em;
        margin-bottom: 15px;
	}
    .full-review {
        display: inline-block;
        background-color: transparent;
        color: #7a49c5;
        border: 1px solid #7a49c5;
        padding: 6px 12px;
        border-radius: 4px;
        text-decoration: none;
        transition: all 0.2s;
    }
    .full-review:hover {
        background-color: #7a49c5;
        color: #fff;
    }
</style>