---
import { getCollection } from "astro:content";
import BaseLayouts from "../layouts/baseLayouts.astro"

// Obtenemos los libros y seleccionamos los últimos 2
const allBooks = await getCollection('books');
const latestBooks = allBooks.slice(-2).reverse();

// Géneros disponibles
const genres = ["Dark Fantasy", "Epic Fantasy"];

// Calculamos las estadísticas
const totalBooks = allBooks.length;
const totalAuthors = new Set(allBooks.map(book => book.data.author)).size;
const totalGenres = new Set(allBooks.map(book => book.data.genres).filter(Boolean).flat()).size;
---

<BaseLayouts>
	<section class="hero">
		<div class="content">
			<h2>Welcome</h2>
			<p>Lorem ipsum dolor sit amet consectetur adipisicing elit. At temporibus consequuntur numquam? Illum fugit consectetur dolor dolore dicta? Optio iure placeat odio reprehenderit, delectus labore iusto molestias consequuntur voluptatem dolore.</p>

			<div class="latest-reviews">
				{latestBooks.map(book => (
					<article class="review-card">
						<div class="book-icon">📖</div>
						<h3>{book.data.title}</h3>
						<p class="rating">Rating: {book.data.rating}/10</p>
						<p class="summary">{book.data.summary}</p>
						<a href={`/books/${book.id}`} class="full-review">Full review</a>
					</article>
				))}
			</div>

			<div class="stats-container">
				<div class="stat-item">
					<span class="stat-value">{totalBooks}</span>
					<span class="stat-label">Books</span>
				</div>
				<div class="stat-item">
					<span class="stat-value">{totalAuthors}</span>
					<span class="stat-label">Authors</span>
				</div>
				<div class="stat-item">
					<span class="stat-value">{totalGenres}</span>
					<span class="stat-label">Genres</span>
				</div>
			</div>

			<a href="/books">Take a look at my reviews</a>
		</div>
	</section>
</BaseLayouts>


<style>
	.hero {
		background-image: url('/wallpaper1.webp');
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 40px 20px;
		box-sizing: border-box;
	}
	.content {
		text-align: center;
		margin: 0 auto !important;
		background-color: rgba(255, 255, 255, 0.7);
		backdrop-filter: blur(10px);
		padding: 50px;
		border-radius: 20px;
		max-width: 1000px;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
	}
	.latest-reviews {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 20px;
		margin: 40px 0;
		text-align: left;
	}
	.review-card {
		background-color: #f9f6fc;
		padding: 20px;
		border-radius: 8px;
		border: 1px solid #e0d5f0;
		display: flex;
		flex-direction: column;
	}
	.book-icon {
		font-size: 2.5rem;
		margin-bottom: 10px;
	}
	.review-card h3 {
		margin: 0 0 5px 0;
	}
	.rating {
		font-weight: 500;
		color: #7a49c5;
		margin-bottom: 10px;
	}
	.summary {
		font-size: 0.9em !important;
		flex-grow: 1;
	}
	a {
		display: inline-block;
		background-color: #7a49c5;
		color: #fff;
		padding: 6px 10px;
		border-radius: 2px;
		text-decoration: none;
		margin-top: 20px;
	}
	a:hover {
		background-color: #965ee9;
	}
	.full-review {
		background-color: transparent;
		color: #7a49c5;
		border: 1px solid #7a49c5;
	}
	.full-review:hover {
		background-color: #7a49c5;
		color: #fff;
	}
	.stats-container {
		display: flex;
		justify-content: center;
		gap: 50px;
		margin: 30px 0;
		padding: 20px;
		border-top: 1px solid rgba(122, 73, 197, 0.2);
	}
	.stat-item {
		display: flex;
		flex-direction: column;
	}
	.stat-value {
		font-size: 2rem;
		font-weight: bold;
		color: #7a49c5;
	}
	.stat-label {
		font-size: 0.9rem;
		color: #666;
	}
</style>