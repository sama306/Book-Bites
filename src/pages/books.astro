---
import { getCollection } from "astro:content";
import BaseLayouts from "../layouts/baseLayouts.astro"
import BookCard from "../components/BookCard.astro";

const allBooks = await getCollection('books');
const uniqueGenres = [...new Set(allBooks.flatMap(book => book.data.genres))].sort();
---

<BaseLayouts>
	<section class="hero">
		<div class="content">
			<h2>Todas mis reseñas</h2>
			<p>Explora la colección completa de libros en los que me he sumergido. De la fantasía a la ciencia ficción, aquí tienes mi visión honesta de cada viaje literario.</p>

			<div class="filter-container">
				<button class="filter-btn active" data-genre="all">Todos</button>
				{uniqueGenres.map(genre => (
					<button class="filter-btn" data-genre={genre}>{genre}</button>
				))}
			</div>

			<div class="reviews-grid">
				{allBooks.map(book => (
					<BookCard book={book} />
				))}
			</div>

			<a href="/" class="back-home">Volver al Inicio</a>
		</div>
	</section>
</BaseLayouts>

<script>
	const filterButtons = document.querySelectorAll('.filter-btn');
	const bookCards = document.querySelectorAll('.book-card');

	filterButtons.forEach(button => {
		button.addEventListener('click', () => {
			const selectedGenre = button.getAttribute('data-genre');

			// Actualizar estado de los botones
			filterButtons.forEach(btn => btn.classList.remove('active'));
			button.classList.add('active');

			// Filtrar las tarjetas
			bookCards.forEach(card => {
				const cardGenres = JSON.parse(card.getAttribute('data-genres') || '[]');
				
				if (selectedGenre === 'all' || cardGenres.includes(selectedGenre)) {
					(card as HTMLElement).style.display = 'flex';
				} else {
					(card as HTMLElement).style.display = 'none';
				}
			});
		});
	});
</script>

<style>
	.hero {
		background-image: url('/wallpaper1.webp');
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 40px 20px;
		box-sizing: border-box;
	}
	.content {
		text-align: center;
		margin: 0 auto !important;
		background-color: rgba(255, 255, 255, 0.7);
		backdrop-filter: blur(10px);
		padding: 50px;
		border-radius: 20px;
		max-width: 1000px;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
	}
	.filter-container {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 10px;
		margin: 25px 0;
	}
	.filter-btn {
		background-color: transparent;
		border: 2px solid #7a49c5;
		color: #7a49c5;
		padding: 6px 18px;
		border-radius: 20px;
		cursor: pointer;
		font-weight: 500;
		transition: all 0.3s ease;
	}
	.filter-btn:hover {
		background-color: #f1edfa;
	}
	.filter-btn.active {
		background-color: #7a49c5;
		color: white;
	}
	.reviews-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
		gap: 50px;
		margin: 40px 0;
		text-align: left;
	}
	a {
		display: inline-block;
		background-color: #7a49c5;
		color: #fff;
		padding: 8px 16px;
		border-radius: 4px;
		text-decoration: none;
	}
	.full-review {
		background-color: transparent;
		color: #7a49c5;
		border: 1px solid #7a49c5;
		margin-top: 20px;
	}
	.full-review:hover {
		background-color: #7a49c5;
		color: #fff;
	}
    .back-home {
        margin-top: 20px;
    }
</style>