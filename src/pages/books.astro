---
import { getCollection } from "astro:content";
import BaseLayouts from "../layouts/baseLayouts.astro"

const allBooks = await getCollection('books');
---

<BaseLayouts>
	<section class="hero">
		<div class="content">
			<h2>All My Reviews</h2>
			<p>Explore the full collection of books I've dived into. From fantasy to science fiction, here is my honest take on every journey.</p>

			<div class="reviews-grid">
				{allBooks.map(book => (
					<article class="review-card">
						<img src={book.data.cover ? (book.data.cover.startsWith('/') ? book.data.cover : `/${book.data.cover}`) : ''} alt={book.data.title} class="book-cover" />
						<div class="review-info">
							<h3>{book.data.title}</h3>
							<p class="author-name">Por {book.data.author}</p>
							<p class="rating">Rating: {book.data.rating}/10</p>
							<p class="summary">{book.data.summary}</p>
							<a href={`/books/${book.id}`} class="full-review">Full review</a>
						</div>
					</article>
				))}
			</div>

			<a href="/" class="back-home">Back to Home</a>
		</div>
	</section>
</BaseLayouts>

<style>
	.hero {
		background-image: url('/wallpaper1.webp');
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 40px 20px;
		box-sizing: border-box;
	}
	.content {
		text-align: center;
		margin: 0 auto !important;
		background-color: rgba(255, 255, 255, 0.7);
		backdrop-filter: blur(10px);
		padding: 50px;
		border-radius: 20px;
		max-width: 1000px;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
	}
	.reviews-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
		gap: 30px;
		margin: 40px 0;
		text-align: left;
	}
	.review-card {
		background-color: #f9f6fc;
		padding: 20px;
		border-radius: 8px;
		border: 1px solid #e0d5f0;
		display: flex;
		gap: 20px;
		align-items: flex-start;
	}
	.book-cover {
		width: 100px;
		height: 150px;
		object-fit: cover;
		border-radius: 4px;
		flex-shrink: 0;
		box-shadow: 0 4px 8px rgba(0,0,0,0.1);
	}
	.review-info { flex: 1; }
	.rating {
		font-weight: 500;
		color: #7a49c5;
		margin-bottom: 10px;
	}
	.summary {
		font-size: 0.9em !important;
		flex-grow: 1;
	}
	a {
		display: inline-block;
		background-color: #7a49c5;
		color: #fff;
		padding: 8px 16px;
		border-radius: 4px;
		text-decoration: none;
	}
	.full-review {
		background-color: transparent;
		color: #7a49c5;
		border: 1px solid #7a49c5;
		margin-top: 20px;
	}
	.full-review:hover {
		background-color: #7a49c5;
		color: #fff;
	}
    .back-home {
        margin-top: 20px;
    }
</style>