---
import { ClientRouter } from 'astro:transitions';
---
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
        <link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap" rel="stylesheet">
		<title>Book Bites</title>
        <ClientRouter />
	</head>
	<body>
		<header>
            <h1 class="logo-container">
                <a href="/">
                    <span class="logo-icon"><img src="/logo.svg" alt="Logo" style="width: 40px; height: auto;"></span>
                    <span>Book Bites</span>
                </a>
            </h1>
            <nav>
                <ul>
                    <li><a href="/">Inicio</a></li>
                    <li><a href="/books">Libros</a></li>
                    <li><a href="/about">Sobre mí</a></li>
                </ul>
            </nav>
        </header>
        <main class="reveal" transition:animate="fade">
            <slot />
        </main>

        <footer>
            <div class="footer-content">
                <div class="footer-top">
                    <div class="footer-brand reveal">
                        <h1>Book Bites</h1>
                        <h3>Contacto:</h3>
                        <ul>
                            <li><p>contacto@gmail.com</p></li>
                            <li><p>+54 11 1234-5678</p></li>
                        </ul>
                    </div>
                    <div class="footer-quote reveal">
                        <p>“Un lector vive mil vidas antes de morir. Aquel que nunca lee solo vive una”</p>
                        <span>— George R.R. Martin</span>
                    </div>
                </div>
                <div class="footer-bottom reveal">
                    <p>2026 Book Bites. Todos los derechos reservados.</p>
                    <nav class="footer-legal">
                        <a href="/terms">Términos y condiciones</a>
                        <a href="/privacy">Política de Privacidad</a>
                    </nav>
                </div>
            </div>
        </footer>

        <script>
            function initLayout() {
                let lastScrollY = window.scrollY;
                const header = document.querySelector('header');

                window.addEventListener('scroll', () => {
                    const currentScrollY = window.scrollY;
                    
                    if (currentScrollY > lastScrollY && currentScrollY > 100) {                    
                        header?.classList.add('header-hidden');
                    } else {
                        header?.classList.remove('header-hidden');
                    }         
                    lastScrollY = currentScrollY;
                });

                // Lógica de animaciones al hacer scroll
                const observerOptions = {
                    threshold: 0.1,
                    rootMargin: '0px 0px -50px 0px'
                };

                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('is-visible');
                        }
                    });
                }, observerOptions);

                document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
            }

            // Inicializar en la primera carga y en cada navegación de Astro
            document.addEventListener('astro:page-load', initLayout);
        </script>
	</body>
</html>

<style>
    body {
        margin: 0;
    }
    header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        box-sizing: border-box;
        z-index: 1000;
        background: linear-gradient(to bottom, #f9f6fc 0%, rgba(249, 246, 252, 0.8) 60%);
        backdrop-filter: blur(20px);
        padding: 10px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        will-change: transform;

        .logo-container a {
            display: flex;
            align-items: center;
            gap: 12px;
            color: inherit;
        }

        .logo-icon {
            font-size: 1.8rem;
            display: flex;
            align-items: center;
            
            img {
                mix-blend-mode: multiply;
            }
        }

        h1 {
            margin: 0;
        }
        nav {
            display: flex;
        }
        ul {
            display: flex;
            list-style-type: none;
            gap: 16px;
        }
        a {
            text-decoration: none;
            border-bottom: 1px;
        }
    }

    .header-hidden {
        transform: translateY(-100%);
        opacity: 0;
    }

    footer {
        background-color: #f1edfa;
        padding: 60px 20px 30px;

        .footer-content {
            max-width: 1200px;
            margin: 0 auto;
        }

        .footer-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 40px;
            flex-wrap: wrap;
            gap: 30px;

            h1 {
                margin: 0 0 10px 0;
                font-size: 1.5rem;
            }
            h3 {
                margin: 15px 0 5px 0;
                font-size: 1rem;
                color: #555;
            }
            ul {
                list-style: none;
                padding: 0;
                margin: 0;
            }
            p {
                margin: 0;
                color: #666;
                font-size: 1rem;
            }
        }

        .footer-quote {
            max-width: 400px;
            text-align: right;
            p {
                font-style: italic;
                font-weight: 300;
                font-size: 1.1rem;
                line-height: 1.6;
                color: #6b5b95;
                border-right: 3px solid #c194ef;
                padding-right: 20px;
                margin: 0;
            }
            span {
                display: block;
                margin-top: 10px;
                font-size: 1rem;
                font-weight: 500;
                color: #8e7cc3;
                padding-right: 23px;
            }
        }

        .footer-bottom {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
            padding-top: 25px;
            border-top: 1px solid rgba(0,0,0,0.05);
            font-size: 0.9rem;
            color: #888;

            .footer-legal {
                display: flex;
                gap: 20px;
                a { color: #888; text-decoration: none; }
                a:hover { text-decoration: underline; }
            }
        }
    }
</style>

<style is:global>
    * {
        font-family: "Poppins", sans-serif;
        color: #333;
    }

    /* Clases de Animación */
    .reveal {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 1.2s cubic-bezier(0.2, 0.8, 0.2, 1), 
                    transform 1.2s cubic-bezier(0.2, 0.8, 0.2, 1);
        will-change: opacity, transform;
    }

    .reveal.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .content {
        width: 100%;
        max-width: 1200px;
        margin: 120px auto 60px;
        padding: 0 20px;
        box-sizing: border-box;

        h2 {
            font-size: 1.8em;
        }
        p {
            font-size: 1rem;
        }
        .author-name {
            color: #8e7cc3;
            font-style: italic;
            font-weight: 500;
            margin: 0 0 10px 0;
            font-size: 0.95rem !important;
        }
        .Likes {
        border: 1px solid #e1d5f5;
        border-radius: 12px;
        background-color: #f9f6fc;
        margin-top: 40px;
        display: flex;
        padding: 10px;
        gap: 20px;
        align-items: center;

        button {
            background-color: #c194ef;
            border: 0;
            color: #fff;
            padding: 6px 10px;
            font-size: 1em;
            border-radius: 4px;
            cursor: pointer;
        }
    }
    }
</style>